{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\npaths=sorted(p for p in Path('inventory').rglob('*.json') if p.is_file())\nentries=[]\nfor path in paths:\n    doc=json.loads(path.read_text())\n    eligible=[r for r in doc['records'] if r.get('enabled') is True and r.get('outcome') == 'ready' and type(r.get('revision')) is int]\n    if not eligible:\n        raise ValueError(f'No eligible record: {path}')\n    record=max(eligible, key=lambda r:r['revision'])\n    entries.append({'path':path.as_posix(),'component':doc['component'],'revision':record['revision'],'label':record['label']})\nassert len(entries)==len(paths)\nprint(json.dumps({'entries':entries},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
